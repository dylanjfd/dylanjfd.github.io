# Fins de ligne normalisées pour les fichiers texte
* text=auto

# Scripts Windows : toujours en CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Fichiers binaires : jamais modifiés par Git
*.pdf   binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.woff2 binary
