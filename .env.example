# Identifiants Gmail pour veille/fetch_replies.py (lecture de tes réponses aux e-mails de veille).
# Copie ce fichier sous le nom .env (à la racine du dépôt) puis remplis les valeurs.
# .env est ignoré par Git : il ne part jamais sur GitHub. Ne mets aucune vraie valeur ici.

# Adresse Gmail qui envoie les e-mails de veille (la même que le secret GitHub GMAIL_USER)
GMAIL_USER=

# Mot de passe d'application Gmail, 16 lettres (pas le mot de passe du compte)
GMAIL_APP_PASSWORD=

# Facultatif : ton adresse, si tes réponses partent d'une autre adresse que GMAIL_USER
VEILLE_TO=
